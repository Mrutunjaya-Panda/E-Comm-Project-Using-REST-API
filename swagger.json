{
  "openapi": "3.0.0",
  "info": {
    "title": "E-Commerce REST API",
    "version": "1.0.0",
    "description": "A fully featured E-Commerce backend REST API built with Node.js, Express and MongoDB. Features include JWT Authentication, Product Management, Cart, Orders and Likes.",
    "contact": {
      "name": "Mrutunjaya Panda",
      "url": "https://github.com/Mrutunjaya-Panda"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3200",
      "description": "Local Development Server"
    },
    {
      "url": "https://e-comm-project-using-rest-api-1.onrender.com",
      "description": "Production Server (Render)"
    }
  ],
  "tags": [
    {
      "name": "Products",
      "description": "Manage products, categories and reviews"
    },
    {
      "name": "Users",
      "description": "Authentication and user management"
    },
    {
      "name": "Cart",
      "description": "Shopping cart operations"
    },
    {
      "name": "Orders",
      "description": "Order placement and tracking"
    },
    {
      "name": "Likes",
      "description": "Like and unlike products"
    }
  ],
  "components": {
    "securitySchemes": {
      "JWT": {
        "in": "header",
        "name": "Authorization",
        "type": "apiKey",
        "description": "Enter your JWT token directly (without 'Bearer' prefix). Obtain a token from POST /api/users/signin."
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "64b1f4c2e4b0f5a3d8e9a123"
          },
          "name": {
            "type": "string",
            "example": "Wireless Headphones"
          },
          "description": {
            "type": "string",
            "example": "Premium noise-cancelling over-ear wireless headphones."
          },
          "price": {
            "type": "number",
            "format": "float",
            "example": 2999.99
          },
          "inStock": {
            "type": "integer",
            "example": 50
          },
          "imageUrl": {
            "type": "string",
            "example": "1691234567890-headphones.jpg"
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          },
          "reviews": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Review"
            }
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "64b1f4c2e4b0f5a3d8e9b456"
          },
          "name": {
            "type": "string",
            "example": "Electronics"
          },
          "products": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["64b1f4c2e4b0f5a3d8e9a123"]
          }
        }
      },
      "Review": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "64b1f4c2e4b0f5a3d8e9c789"
          },
          "productId": {
            "type": "string",
            "example": "64b1f4c2e4b0f5a3d8e9a123"
          },
          "userId": {
            "type": "string",
            "example": "64b1f4c2e4b0f5a3d8e9d000"
          },
          "rating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "example": 4
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "64b1f4c2e4b0f5a3d8e9d000"
          },
          "name": {
            "type": "string",
            "example": "Mrutunjaya Panda"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "mrutunjaya@example.com"
          },
          "type": {
            "type": "string",
            "enum": ["customer", "seller"],
            "example": "customer"
          }
        }
      },
      "CartItem": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "64b1f4c2e4b0f5a3d8e9e111"
          },
          "productId": {
            "type": "string",
            "example": "64b1f4c2e4b0f5a3d8e9a123"
          },
          "userId": {
            "type": "string",
            "example": "64b1f4c2e4b0f5a3d8e9d000"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "example": 2
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "64b1f4c2e4b0f5a3d8e9f222"
          },
          "userId": {
            "type": "string",
            "example": "64b1f4c2e4b0f5a3d8e9d000"
          },
          "totalAmount": {
            "type": "number",
            "format": "float",
            "example": 5999.98
          },
          "timeStamp": {
            "type": "string",
            "format": "date-time",
            "example": "2024-08-30T06:17:00.000Z"
          }
        }
      },
      "Like": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "64b1f4c2e4b0f5a3d8e9g333"
          },
          "user": {
            "type": "string",
            "example": "64b1f4c2e4b0f5a3d8e9d000"
          },
          "likeable": {
            "type": "string",
            "description": "ObjectId of the liked Product or Category",
            "example": "64b1f4c2e4b0f5a3d8e9a123"
          },
          "types": {
            "type": "string",
            "enum": ["Product", "Category"],
            "example": "Product"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "An error occurred."
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Operation completed successfully."
          }
        }
      }
    }
  },
  "paths": {
    "/api/products": {
      "get": {
        "tags": ["Products"],
        "summary": "Get all products",
        "description": "Retrieves a list of all products available in the store.",
        "security": [{ "JWT": [] }],
        "responses": {
          "200": {
            "description": "A list of all products returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Product" }
                },
                "example": [
                  {
                    "_id": "64b1f4c2e4b0f5a3d8e9a123",
                    "name": "Wireless Headphones",
                    "description": "Premium noise-cancelling over-ear wireless headphones.",
                    "price": 2999.99,
                    "inStock": 50,
                    "imageUrl": "1691234567890-headphones.jpg",
                    "categories": ["64b1f4c2e4b0f5a3d8e9b456"],
                    "reviews": []
                  },
                  {
                    "_id": "64b1f4c2e4b0f5a3d8e9a124",
                    "name": "Running Shoes",
                    "description": "Lightweight and breathable running shoes for all terrains.",
                    "price": 1499.50,
                    "inStock": 120,
                    "imageUrl": "1691234567891-shoes.jpg",
                    "categories": ["64b1f4c2e4b0f5a3d8e9b457"],
                    "reviews": []
                  }
                ]
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT token is missing or invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Token is missing/unauthorized" }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Internal Server Error, Please try again later." }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Products"],
        "summary": "Add a new product",
        "description": "Creates a new product with an optional image upload using multipart/form-data.",
        "security": [{ "JWT": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["name", "price", "description"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Name of the product",
                    "example": "Wireless Headphones"
                  },
                  "description": {
                    "type": "string",
                    "description": "Detailed description of the product",
                    "example": "Premium noise-cancelling over-ear wireless headphones."
                  },
                  "price": {
                    "type": "number",
                    "description": "Price of the product",
                    "example": 2999.99
                  },
                  "categories": {
                    "type": "string",
                    "description": "Comma-separated list of existing Category ObjectIds (the API converts each value to an ObjectId, so category names are not accepted)",
                    "example": "64b1f4c2e4b0f5a3d8e9b456,64b1f4c2e4b0f5a3d8e9b457"
                  },
                  "imageUrl": {
                    "type": "string",
                    "format": "binary",
                    "description": "Product image file to upload"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product created successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Product" },
                "example": {
                  "_id": "64b1f4c2e4b0f5a3d8e9a123",
                  "name": "Wireless Headphones",
                  "description": "Premium noise-cancelling over-ear wireless headphones.",
                  "price": 2999.99,
                  "imageUrl": "1691234567890-headphones.jpg",
                  "categories": [],
                  "reviews": []
                }
              }
            }
          },
          "400": {
            "description": "Bad request - validation failed or missing required fields.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Product validation failed: name: Path `name` is required." }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT token is missing or invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Token is missing/unauthorized" }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Internal Server Error, Please try again later." }
              }
            }
          }
        }
      }
    },
    "/api/products/filter": {
      "get": {
        "tags": ["Products"],
        "summary": "Filter products by price and category",
        "description": "Filters products based on minimum price, maximum price, and/or categories.",
        "security": [{ "JWT": [] }],
        "parameters": [
          {
            "name": "minPrice",
            "in": "query",
            "required": false,
            "schema": { "type": "number", "example": 500 },
            "description": "Minimum price filter (inclusive)."
          },
          {
            "name": "maxPrice",
            "in": "query",
            "required": false,
            "schema": { "type": "number", "example": 5000 },
            "description": "Maximum price filter (inclusive)."
          },
          {
            "name": "categories",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "['Electronics', 'Audio']" },
            "description": "JSON-like array string of category names (e.g., ['Electronics', 'Audio'])."
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered list of products returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Product" }
                },
                "example": [
                  {
                    "_id": "64b1f4c2e4b0f5a3d8e9a123",
                    "name": "Wireless Headphones",
                    "description": "Premium noise-cancelling over-ear wireless headphones.",
                    "price": 2999.99,
                    "inStock": 50,
                    "imageUrl": "1691234567890-headphones.jpg",
                    "categories": ["64b1f4c2e4b0f5a3d8e9b456"],
                    "reviews": []
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad request - invalid or missing query parameters.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Invalid filter parameters provided." }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT token is missing or invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Token is missing/unauthorized" }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Internal Server Error, Please try again later." }
              }
            }
          }
        }
      }
    },
    "/api/products/averagePrice": {
      "get": {
        "tags": ["Products"],
        "summary": "Get average product price by category",
        "description": "Returns the average price of products grouped by each category using MongoDB aggregation.",
        "security": [{ "JWT": [] }],
        "responses": {
          "200": {
            "description": "Average price per category returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "_id": {
                        "type": "string",
                        "description": "Category name or ObjectId"
                      },
                      "averagePrice": {
                        "type": "number",
                        "format": "float"
                      }
                    }
                  }
                },
                "example": [
                  { "_id": "Electronics", "averagePrice": 4250.75 },
                  { "_id": "Footwear", "averagePrice": 1200.00 }
                ]
              }
            }
          },
          "400": {
            "description": "Bad request - error during aggregation.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Error while calculating average price." }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT token is missing or invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Token is missing/unauthorized" }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Internal Server Error, Please try again later." }
              }
            }
          }
        }
      }
    },
    "/api/products/rate": {
      "post": {
        "tags": ["Products"],
        "summary": "Rate a product",
        "description": "Allows an authenticated user to submit a numeric rating for a specific product via query parameters.",
        "security": [{ "JWT": [] }],
        "parameters": [
          {
            "name": "productId",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "64b1f4c2e4b0f5a3d8e9a123" },
            "description": "The MongoDB ObjectId of the product to be rated."
          },
          {
            "name": "rating",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "minimum": 1, "maximum": 5, "example": 4 },
            "description": "Rating value between 1 and 5."
          }
        ],
        "responses": {
          "200": {
            "description": "Product rated successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" },
                "example": { "message": "Product rated successfully" }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT token is missing or invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Token is missing/unauthorized" }
              }
            }
          },
          "404": {
            "description": "Product or user not found.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Product not found" }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Internal Server Error, Please try again later." }
              }
            }
          }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get a product by ID",
        "description": "Retrieves the full details of a single product by its MongoDB ObjectId.",
        "security": [{ "JWT": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "64b1f4c2e4b0f5a3d8e9a123" },
            "description": "The MongoDB ObjectId of the product."
          }
        ],
        "responses": {
          "200": {
            "description": "Product found and returned successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Product" },
                "example": {
                  "_id": "64b1f4c2e4b0f5a3d8e9a123",
                  "name": "Wireless Headphones",
                  "description": "Premium noise-cancelling over-ear wireless headphones.",
                  "price": 2999.99,
                  "inStock": 50,
                  "imageUrl": "1691234567890-headphones.jpg",
                  "categories": [
                    {
                      "_id": "64b1f4c2e4b0f5a3d8e9b456",
                      "name": "Electronics",
                      "products": ["64b1f4c2e4b0f5a3d8e9a123"]
                    }
                  ],
                  "reviews": [
                    {
                      "_id": "64b1f4c2e4b0f5a3d8e9c789",
                      "productId": "64b1f4c2e4b0f5a3d8e9a123",
                      "userId": "64b1f4c2e4b0f5a3d8e9d000",
                      "rating": 4
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid ObjectId format.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Invalid product id" }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT token is missing or invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Token is missing/unauthorized" }
              }
            }
          },
          "404": {
            "description": "Product not found.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Product not found" }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Internal Server Error, Please try again later." }
              }
            }
          }
        }
      }
    },
    "/api/users/signup": {
      "post": {
        "tags": ["Users"],
        "summary": "Register a new user",
        "description": "Creates a new user account with name, email, password, and account type.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password", "type"],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Mrutunjaya Panda"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "mrutunjaya@example.com"
                  },
                  "password": {
                    "type": "string",
                    "description": "Min 8 characters with at least one uppercase, one lowercase, and one number.",
                    "example": "SecurePass1"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["customer", "seller"],
                    "example": "customer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" },
                "example": {
                  "_id": "64b1f4c2e4b0f5a3d8e9d000",
                  "name": "Mrutunjaya Panda",
                  "email": "mrutunjaya@example.com",
                  "type": "customer"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - validation failed (e.g., weak password, invalid email, or duplicate email).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": {
                  "message": "Password must be at least 8 characters long and contain at least one uppercase letter, one lowercase letter, and one number"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Internal Server Error, Please try again later." }
              }
            }
          }
        }
      }
    },
    "/api/users/signin": {
      "post": {
        "tags": ["Users"],
        "summary": "Sign in a user",
        "description": "Authenticates a user with email and password and returns a JWT token for accessing protected routes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "mrutunjaya@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "SecurePass1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User signed in successfully. Returns a raw JWT token string (not a JSON object). Use this string verbatim as the Authorization header value on protected routes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY0YjFmNGMyZTRiMGY1YTNkOGU5ZDAwMCIsImVtYWlsIjoibXJ1dHVuamF5YUBleGFtcGxlLmNvbSIsImlhdCI6MTY5MTIzNDU2NywiZXhwIjoxNjkxMzIwOTY3fQ.abc123signature"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - incorrect email or password.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Incorrect credentials" }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Internal Server Error, Please try again later." }
              }
