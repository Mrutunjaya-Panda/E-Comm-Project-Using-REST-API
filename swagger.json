                "example": { "message": "Item liked successfully" }
              }
            }
          },
          "400": {
            "description": "Bad request - missing id/type or invalid type value (must be Product or Category).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Invalid type, must be either Product or Category" }
              }
