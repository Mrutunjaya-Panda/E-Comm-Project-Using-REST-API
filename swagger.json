    "/api/likes": {
      "post": {
        "tags": ["Likes"],
        "summary": "Like a product or category",
        "description": "Allows an authenticated user to like a product or category by providing its ObjectId and entity type.",
        "security": [{ "JWT": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id", "type"],
